---
layout: page
---
{{ content }}
{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% assign sorted_items = collection | sort: 'date' | reverse %}
    {% assign last_year = '' %}

    {% for item in sorted_items %}
      {% assign current_year = item.date | date: '%Y' %}

      {% if current_year != last_year %}
        {% unless forloop.first %}</ul>{% endunless %}

        <h1 id="y{{ current_year }}" class="year-heading">
          <a href="{{ current_year | prepend: '/books/' | relative_url }}">{{ current_year }}</a>
        </h1>
        <hr>
        <ul class="book-grid">
          {% assign last_year = current_year %}
      {% endif %}

      <figure class="cover">
        <a class="cover-link" href="{{ item.url | relative_url }}">
          {% if item.cover %}
            <img
              alt="{{ item.title }} cover"
              src="{% if item.cover contains '://' %}{{ item.cover }}{% else %}{{ item.cover | relative_url }}{% endif %}"
              style="height:200px"
            >
          {% elsif item.isbn %}
            <img
              alt="{{ item.title }} cover"
              src="https://images-na.ssl-images-amazon.com/images/P/{{ item.isbn | strip }}.01.LZZZZZZZ.jpg"
              style="height:200px"
              onerror="this.src='https://covers.openlibrary.org/b/isbn/{{ item.isbn | strip }}-L.jpg';"
            >
          {% elsif item.olid %}
            <img alt="{{ item.title }} cover" src="https://covers.openlibrary.org/b/olid/{{ item.olid | strip }}-L.jpg" style="height:200px">
          {% endif %}

          {% if item.status %}
            {% assign status = item.status | downcase | strip %}
            <figcaption class="{{ status }}">{{ status | upcase }}</figcaption>
          {% else %}
            <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
          {% endif %}
        </a>
      </figure>

      {% if forloop.last %}</ul>{% endif %}
    {% endfor %}
  {% endif %}
{% endif %}
